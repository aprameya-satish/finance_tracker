# Local FastAPI + Plaid. Copy to .env and fill in secrets. Never commit .env.

# Use 0.0.0.0 so an iPhone on the same Wi-Fi can reach the API
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aprameya-satish.github.io

# SQLite path (created on first run)
DATABASE_URL=sqlite:///./data/finance.db

# Optional Fernet key (url-safe base64, 32 bytes). If unset, a key is written to data/token.key
PLAID_TOKEN_KEY=

# Plaid (sandbox for fake data; production for live Chase/Amex)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_LANGUAGE=en
# Required for Chase/Amex OAuth. Register the same URI in the Plaid dashboard.
# Phone PWA: https://aprameya-satish.github.io/finance_tracker/accounts
PLAID_REDIRECT_URI=

# Optional shared secret. If set, the phone app must send it as X-Finance-Key.
API_SHARED_SECRET=

# Default directory for bulk CSV import
CSV_IMPORT_DIRECTORY=

# Background sync interval in hours (0 disables)
PLAID_SYNC_INTERVAL_HOURS=6
